# Copy this file to .env and fill in the values.

# --- Database --------------------------------------------------------------
# Your Atlas cluster (put your password in place of <password>).
# Use MONGO_URI=memory to run offline on the bundled demo data (resets on restart).
MONGO_URI=mongodb+srv://elayne-admin:<password>@chatbot.3bukmtm.mongodb.net/?appName=CHATBOT
# New database the migration writes to. Your original "LMS" database is only read.
MONGO_DB=edulayne

# --- Auth -------------------------------------------------------------------
# Any long random string. Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=480

# --- Language model -----------------------------------------------------------
# Option A: Groq (default). Groq retired self-serve Llama models in Aug 2026;
# openai/gpt-oss-120b is Groq's recommended replacement.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-120b
LLM_ROUTER_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low

# Option B: Llama locally with Ollama (ollama pull llama3.1:8b)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1:8b
# LLM_ROUTER_MODEL=llama3.1:8b
# LLM_REASONING_EFFORT=

# --- Academic settings ----------------------------------------------------------
LOW_ATTENDANCE=75
DEFAULT_PASS_MARK=40

CORS_ORIGINS=http://localhost:5173
